# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB (Atlas free tier works fine — see README)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wajd

# Firebase Admin — used ONLY to verify auth tokens, no Firestore/DB usage.
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the private_key value as-is; \n sequences are handled automatically.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The email allowed to access admin routes
ADMIN_EMAIL=you@example.com

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx

# Anthropic (optional — powers the admin "Write description" button)
ANTHROPIC_API_KEY=sk-ant-xxx
