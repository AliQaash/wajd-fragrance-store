REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ADMIN_EMAIL=you@example.com

# Firebase web config — from Firebase Console > Project Settings > General > Your apps
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# REACT_APP_ADMIN_EMAIL only decides whether the Admin link shows while the API is unreachable;
# the server's role check (custom claim or ADMIN_EMAIL) is what actually grants access.
